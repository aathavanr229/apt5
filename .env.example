# Aptitude Forge Environment Configuration

# MongoDB Atlas Connection URI (Required for persistent multi-user storage and leaderboard)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_user:your_password@cluster0.example.mongodb.net/aptitude_forge?retryWrites=true&w=majority

# Gemini API Key (Required for AI question generation and mathematical equivalence grading)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret for student session tokens (Required in production)
JWT_SECRET=your_secure_jwt_random_secret_string_here

# Server Port (Defaults to 3000 in local dev)
PORT=3000
